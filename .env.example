# Token del bot creado con @BotFather (OBLIGATORIO)
TELEGRAM_BOT_TOKEN=

# Idioma destino por defecto (código de Google: es, en, pt, fr, de, it, ja, zh...)
DEFAULT_TARGET_LANG=es

# Motor de traducción:
#   auto        → Google gratis y, si se bloquea, Microsoft (Edge/Bing) de
#                 relevo (recomendado; el bloqueo de Google no detiene el libro).
#   web/google  → solo el endpoint web gratuito de Google.
#   ms/microsoft→ solo el traductor gratuito de Microsoft.
#   api         → Google Cloud Translation oficial; requiere GOOGLE_API_KEY y
#                 facturación. Aguanta volúmenes enormes sin bloqueos (ideal
#                 para novelas de +1000 capítulos en servidores de pago).
TRANSLATOR_BACKEND=auto
GOOGLE_API_KEY=

# Peticiones simultáneas al traductor (súbelo con cuidado: si se abusa, los
# proveedores responden con errores temporales y el bot frena solo unos segundos).
TRANSLATE_CONCURRENCY=6

# Ritmo del endpoint web gratuito: segundos mínimos entre peticiones y tope
# cuando Google empieza a limitar (HTTP 429). Desde Render o cualquier servidor
# (IP de datacenter) conviene ir despacio: WEB_MIN_INTERVAL=1 y
# WEB_MAX_INTERVAL=10 es un buen punto de partida.
WEB_MIN_INTERVAL=0.6
WEB_MAX_INTERVAL=8

# Documentos que se traducen a la vez (1 es lo más seguro).
MAX_CONCURRENT_JOBS=1

# Divisor de novelas (/dividir): capítulos por sección, páginas por sección en
# PDF sin índice y máximo de secciones que se envían de una vez.
SPLIT_CHAPTERS_PER_PART=50
SPLIT_PAGES_PER_PART=100
SPLIT_MAX_PARTS=100

# Tamaño máximo del archivo de entrada en MB. Los bots de Telegram no pueden
# descargar archivos de más de 20 MB.
MAX_INPUT_MB=20

# Tamaño máximo del archivo que envía el bot en MB (Telegram permite 50).
MAX_OUTPUT_MB=48

# Carpeta de datos: tareas temporales, progreso para reanudar y resultados.
DATA_DIR=data

# Los resultados traducidos se guardan para reenviarlos al instante si se
# repite el mismo documento. Se borran solos pasado CACHE_TTL_DAYS o cuando la
# caché supera CACHE_MAX_MB.
CACHE_TTL_DAYS=7
CACHE_MAX_MB=512

# Puerto del servidor HTTP de salud (Render lo asigna solo con la variable PORT;
# en local no hace falta).
# HEALTH_PORT=10000
