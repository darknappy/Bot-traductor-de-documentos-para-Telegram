# Token del bot creado con @BotFather (OBLIGATORIO)
TELEGRAM_BOT_TOKEN=

# Idioma destino por defecto (código de Google: es, en, pt, fr, de, it, ja, zh...)
DEFAULT_TARGET_LANG=es

# Motor de traducción (por defecto del servidor; cada usuario puede cambiarlo
# con el botón 🧠 Motor o /motor):
#   auto        → Google gratis (método nuevo) y, si se bloquea, Microsoft
#                 (Edge/Bing) y DeepL de relevo (recomendado; el bloqueo de
#                 Google no detiene el libro).
#   web/google  → solo el endpoint web gratuito de Google.
#   ms/microsoft→ solo el traductor gratuito de Microsoft.
#   deepl       → solo DeepL gratuito (más calidad, más pausado).
#   api         → Google Cloud Translation oficial; requiere GOOGLE_API_KEY y
#                 facturación. Aguanta volúmenes enormes sin bloqueos (ideal
#                 para novelas de +1000 capítulos en servidores de pago).
TRANSLATOR_BACKEND=auto
GOOGLE_API_KEY=

# Peticiones simultáneas al traductor (súbelo con cuidado: si se abusa, los
# proveedores responden con errores temporales y el bot frena solo unos segundos).
TRANSLATE_CONCURRENCY=6

# Ritmo del endpoint web gratuito: segundos mínimos entre peticiones y tope
# cuando Google empieza a limitar (HTTP 429). Desde Render o cualquier servidor
# (IP de datacenter) conviene ir despacio: WEB_MIN_INTERVAL=1 y
# WEB_MAX_INTERVAL=10 es un buen punto de partida.
WEB_MIN_INTERVAL=0.6
WEB_MAX_INTERVAL=8

# Documentos que se traducen a la vez (1 es lo más seguro).
MAX_CONCURRENT_JOBS=1

# Cola personal: puedes enviar varios volúmenes seguidos. Se procesan de uno en
# uno, en orden. Límites para no llenar el almacenamiento por error.
QUEUE_MAX_FILES=10
QUEUE_MAX_MB=100
# Preguntas «¿qué hago con este archivo?» pendientes a la vez.
PENDING_MAX_FILES=20

# --- Supabase (opcional pero recomendado para Render) -----------------------
# Con estas dos variables, los originales, la cola, el progreso y los
# resultados se guardan en Supabase. Si Render se reinicia o redeploya, el bot
# recupera las tareas solo y no hay que reenviar ningún archivo.
#
# 1. Crea un proyecto gratis en https://supabase.com
# 2. SQL Editor → pega y ejecuta supabase_schema.sql
# 3. Project Settings → API: copia «Project URL» y la clave «service_role».
# 4. Añádelas en Render → Environment (nunca en el repositorio).
#
# Usa SOLO la service_role en el servidor. La anon key no tiene permisos sobre
# estas tablas (RLS activado) y el bot no podría guardar nada.
# SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_KEY=eyJhbGciOi...service_role...
# Bucket privado de Storage; el bot lo crea si no existe.
SUPABASE_BUCKET=traductor
# Tiempo máximo de espera de las peticiones a Supabase (segundos).
SUPABASE_TIMEOUT=12
# Nombres de tabla (cámbialos también en supabase_schema.sql si los tocas).
SUPABASE_JOBS_TABLE=bot_jobs
SUPABASE_USERS_TABLE=bot_users

# Divisor de novelas (/dividir): capítulos por sección, páginas por sección en
# PDF sin índice y máximo de secciones que se envían de una vez.
SPLIT_CHAPTERS_PER_PART=50
SPLIT_PAGES_PER_PART=100
SPLIT_MAX_PARTS=100

# Tamaño máximo del archivo de entrada en MB. Los bots de Telegram no pueden
# descargar archivos de más de 20 MB.
MAX_INPUT_MB=20

# Tamaño máximo del archivo que envía el bot en MB (Telegram permite 50).
MAX_OUTPUT_MB=48

# Carpeta de datos: tareas temporales, progreso para reanudar y resultados.
DATA_DIR=data

# Los resultados traducidos se guardan para reenviarlos al instante si se
# repite el mismo documento. Se borran solos pasado CACHE_TTL_DAYS o cuando la
# caché supera CACHE_MAX_MB.
CACHE_TTL_DAYS=7
CACHE_MAX_MB=512

# Puerto del servidor HTTP de salud (Render lo asigna solo con la variable PORT;
# en local no hace falta).
# HEALTH_PORT=10000
